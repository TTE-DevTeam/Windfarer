      forbidden:
        - "minecraft:bedrock"
    can_switch_world: false
    can_be_named: true
    rotate_at_midpoint: true
    merge_piston_extensions: true
    release_timeout: 1000
  movement:
    speed:
      speed: 4.00
    cruise:
      enabled: false
      skip_blocks: 1
      vert_skip_blocks: 0
      speed: 2.0
      vert_speed: 1.0
    passthrough_blocks:
      - "#minecraft:air"
    can_direct_control: false
    entities:
      enabled: false
      only_players: false
  constraints:
    size:
      max: 40000
      min: 10
    movement:
      can_fly: true
      static_move:
        enabled: true
        max: 2
      height_limit:
        min: -64
        max: 320
      max_ground_distance: 400
      allow_vertical_takeoff_and_landing: true
    block:
      flyblocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Core"
          min: N1
          max: 100.0
          blocks:
            - "minecraft:beacon"
      detection_blocks:
      move_blocks:
  try_nudge: false
  fuel:
    burn_rate: 0.0
  contacts:
    detection:
      multiplier: 100.0
      underwater_multiplier: 100.0
    new_contact_sound:
      ==: Movecraft_ConfiguredSound
      Sound: "block.note_block.bit"
      Category: "PLAYERS"
      MinVolume: 1.0
      MaxVolume: 1.0
      MinPitch: 1.20
      MaxPitch: 1.30
  sinking:
    #Old sinkpercent!
    constraint_intolerance: 100.0
    #Old overall sinkpercent!
    lowest_possible_integrity: 25.0
    speed: 1.0
    keep_moving: false
    sink_on_out_of_fuel: false
    smoke: 0
    explosion:
      strength: 0.0
      incendiary: false
    falling_block_chance: 0.2
    pretty:
      enabled: false
movecraft-shiprules:
  require_cruise_sign_alignment: false
movecraft-combat:
  #Directors
  allow_aa_director_sign: false
  allow_cannon_director_sign: false